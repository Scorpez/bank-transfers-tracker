# Wise
WISE_API_TOKEN=your_wise_api_token
WISE_PROFILE_ID=your_profile_id
# Set after running: python main.py list-wise-balances
WISE_BALANCE_ID=

# Revolut — export CSV from Revolut app, then:
#   python main.py import-revolut path/to/revolut.csv
# Or drop CSVs into this directory for batch sync:
REVOLUT_CSV_DIR=./revolut_csv

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
GOOGLE_SHEET_ID=your_google_sheet_id

# Names your own transfers arrive under, comma-separated. Used to tell a movement
# between your own accounts apart from real income.
ACCOUNT_HOLDER_NAMES=Ada Lovelace,Lovelace Ada

# A recurring fixed transfer to categorise as an allowance rather than salary. 0 disables.
ALLOWANCE_AMOUNT=0

# A recurring counterparty whose larger payments are rent and smaller ones utilities.
# Leave empty to disable.
RENT_PAYER_NAMES=
RENT_THRESHOLD=0
